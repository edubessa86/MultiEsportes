{
  "name": "esportes-app-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "setup": "node scripts/init-env.mjs",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx src/index.ts",
    "start:local": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx --env-file=.env scripts/e2e.ts"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.0",
    "graphql": "^16.9.0",
    "graphql-yoga": "^5.7.0",
    "jose": "^5.9.0",
    "pg": "^8.12.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.6.0"
  }
}
