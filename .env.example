# Copie para .env (ou rode: npm run setup, que já gera o JWT_SECRET)
PORT=4000
# 127.0.0.1 = só esta máquina. 0.0.0.0 = acessível na rede (para testar pelo celular)
HOST=127.0.0.1
DATABASE_URL=postgres://app_rw:app_rw_dev_password@localhost:5432/appdb
# Gere com: openssl rand -base64 48   (mínimo 32 caracteres; NUNCA versione)
JWT_SECRET=
# development habilita o GraphiQL em /graphql
NODE_ENV=development
